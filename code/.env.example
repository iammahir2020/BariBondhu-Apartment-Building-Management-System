# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database: transaction pooler for the app, session pooler or direct for migrations
DATABASE_URL=
DATABASE_URL_MIGRATE=

# Email (SMTP) for password reset links
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Public address of the app, used in emails
APP_URL=http://localhost:3000

# Password of the demo accounts made by npm run db:seed. Share it with the team privately, never in git.
SEED_DEMO_PASSWORD=
